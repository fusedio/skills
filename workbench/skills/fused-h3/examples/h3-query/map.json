{
  "type": "fused-map",
  "props": {
    "style": "height:100%",
    "layers": [{
      "id": "t2m",
      "type": "h3",
      "h3Column": "hex",
      "data": "{{h3_rows}}",
      "sql": "SELECT hex, t2m_max - 273.15 AS t2m_c FROM {{source}}",
      "tooltip": true,
      "style": { "fillColor": { "type": "continuous", "attr": "t2m_c", "palette": "Sunset" }, "opacity": 0.8 }
    }]
  }
}
